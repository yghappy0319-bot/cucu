# ────────────── Pokazone 기본 설정 ──────────────
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /sitemap.xml → sitemap.php 로 라우팅
    RewriteRule ^sitemap\.xml$ /sitemap.php [L]

    # /rss.xml → rss.php 로 라우팅
    RewriteRule ^rss\.xml$ /rss.php [L]

    # 구 /page/ 경로 호환
    RewriteRule ^page/sitemap\.php$ /sitemap.php [L,R=301]
    RewriteRule ^page/rss\.php$ /rss.php [L,R=301]

    # ── 모듈 경로 (구 URL 호환) ──
    RewriteRule ^trade\.php$ /trade/trade.php [L,R=301]
    RewriteRule ^trade_(.+)\.php$ /trade/trade_$1.php [L,R=301]
    RewriteRule ^page/trade(.+)\.php$ /trade/trade$1.php [L,R=301]
    RewriteRule ^auction\.php$ /auction/auction.php [L,R=301]
    RewriteRule ^auction_(.+)\.php$ /auction/auction_$1.php [L,R=301]
    RewriteRule ^page/auction(.+)\.php$ /auction/auction$1.php [L,R=301]
    RewriteRule ^page/mypage_auction(.+)\.php$ /auction/mypage_auction$1.php [L,R=301]
    RewriteRule ^proc/trade_(.+)\.php$ /trade/proc/trade_$1.php [L,R=301]
    RewriteRule ^proc/auction_(.+)\.php$ /auction/proc/auction_$1.php [L,R=301]
    RewriteRule ^cron/trade_bank_deposit_confirm\.php$ /trade/cron/trade_bank_deposit_confirm.php [L,R=301]
    RewriteRule ^cron/auction_finalize\.php$ /auction/cron/auction_finalize.php [L,R=301]
    RewriteRule ^page/login\.php$ /login.php [L,R=301,QSA]
    RewriteRule ^page/logout\.php$ /logout.php [L,R=301]

    # ── 일반 페이지 (구 루트 URL → /page/) ──
    RewriteRule ^(about|alarm_settings|attendance|card_price|community|community_view|community_write|draw|draw_view|faq|find|guide|inquiry|inquiry_view|member_address|member_info|mypage|mypage_cash|notice|notice_view|notice_write|partner|privacy|register|search|shop|shop_view|terms|webpush_api)\.php$ /page/$1.php [L,R=301]
</IfModule>

# 거래글 사진 최대 8장 × 20MB + 폼 여유
<IfModule mod_php.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 256M
    php_value max_file_uploads 20
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 256M
    php_value max_file_uploads 20
</IfModule>

# 정적 리소스 캐시 (모듈 있을 때만)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                       "access plus 30 days"
    ExpiresByType application/javascript         "access plus 30 days"
    ExpiresByType text/javascript                "access plus 30 days"
    ExpiresByType image/jpeg                     "access plus 180 days"
    ExpiresByType image/png                      "access plus 180 days"
    ExpiresByType image/gif                      "access plus 180 days"
    ExpiresByType image/webp                     "access plus 180 days"
    ExpiresByType image/svg+xml                  "access plus 180 days"
    ExpiresByType image/x-icon                   "access plus 365 days"
    ExpiresByType font/woff2                     "access plus 365 days"
</IfModule>

# 압축 (모듈 있을 때만)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml
</IfModule>

# 보안 헤더 (모듈 있을 때만)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # PWA: SW·매니페스트는 짧은 캐시(업데이트 반영)
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
